# syntax=docker/dockerfile:1
#
# rubc web — DEVELOPMENT image (hot-reload).
#
# Runs `next dev` (Turbopack HMR) against a bind-mounted ./web so edits show up
# live in the browser. This is the opposite of the production Dockerfile, which
# compiles a static export and serves it through nginx.
#
#   docker compose up web-dev          # then open http://localhost:3000/
#
# The wasm bundle (web/src/lib/wasm/) is already committed, so dev does NOT
# recompile Rust — only the UI hot-reloads.

FROM node:22-bookworm-slim

WORKDIR /web

# Install deps against the committed lockfile (this layer is cached unless
# package*.json change). node_modules lives in the image, NOT the bind mount,
# so host/container platform differences never collide (see the anonymous
# volume in docker-compose.yml).
COPY web/package.json web/package-lock.json ./
RUN npm ci

# App sources are bind-mounted at runtime (see compose). Nothing else to copy.

EXPOSE 3000

# Bind to 0.0.0.0 so the port is reachable from the host; Turbopack HMR works
# over the mapped port. CHOKIDAR/Next polling is enabled via env in compose for
# reliable file-watching across the Docker bind-mount boundary on macOS.
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
