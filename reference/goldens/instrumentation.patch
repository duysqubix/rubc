+static uint64_t parse_u64_env(const char *name, uint64_t fallback, bool *present)
+{
+    const char *value = getenv(name);
+    if (value && value[0]) {
+        if (present) *present = true;
+        return strtoull(value, NULL, 10);
+    }
+    return fallback;
+}
+
+internal void GB_golden_trace_advance(uint64_t cycles)
+{
+    golden_trace_raw_tick += cycles;
+}
+
+internal uint64_t GB_golden_trace_raw_tick(void)
+{
+    return golden_trace_raw_tick;
+}
+
+internal bool GB_golden_trace_enabled(void)
+{
+    if (!golden_trace_checked_env) {
+        golden_trace_checked_env = true;
+        const char *path = getenv("SAMEBOY_GOLDEN_TRACE");
+        if (path && path[0]) {
+            const char *schema = getenv("SAMEBOY_GOLDEN_TRACE_SCHEMA");
+            golden_trace_schema = (schema && schema[0] == '2') ? 2 : 1;
+            bool have_ly = false;
+            bool have_frame = false;
+            golden_trace_target_ly = (uint8_t)parse_u64_env("SAMEBOY_GOLDEN_TRACE_LY", 0, &have_ly);
+            golden_trace_target_frame = parse_u64_env("SAMEBOY_GOLDEN_TRACE_FRAME", 0, &have_frame);
+            golden_trace_has_env_target = have_ly || have_frame;
+            const char *dump_after = getenv("SAMEBOY_GOLDEN_TRACE_DUMP_AFTER_FIRST_WRITE");
+            golden_trace_v2_dump_after_first_write = dump_after && dump_after[0] == '1';
+            const char *public = getenv("SAMEBOY_GOLDEN_TRACE_PUBLIC");
+            golden_trace_public = public && public[0] == '1';
+            const char *lcdon = getenv("SAMEBOY_GOLDEN_TRACE_LCDON_EVENTS");
+            golden_trace_lcdon_events = lcdon && lcdon[0] == '1';
+            golden_trace_file = fopen(path, "w");
+            if (!golden_trace_file) {
+                perror("SAMEBOY_GOLDEN_TRACE");
+                abort();
+            }
+            if (golden_trace_schema == 2) {
+                fputs(v23_header, golden_trace_file);
+            }
+            else {
+                fputs("kind\tframe\traw_tick\tly\tline_tick\tdot\tstate\tx\tscreen_x\taddr\tbyte\traw_color\tpalette_kind\tpalette_reg\tpalette_value\tio_scy\tio_lcdc\tio_wx\tpos\tconflict\tnorm_dot\n", golden_trace_file);
+            }
+        }
+    }
+    return golden_trace_file && !golden_trace_complete;
+}
+
+internal bool GB_golden_trace_disable_mode3_batching(void)
+{
+    return GB_golden_trace_enabled();
+}
+
+static void golden_trace_emit_or_buffer(GB_gameboy_t *gb, const char *line)
+{
+    if (!GB_golden_trace_enabled()) return;
+    if (golden_trace_target_line && gb->current_line == golden_trace_target_ly) {
+        fputs(line, golden_trace_file);
+    }
+    else if (golden_trace_buffer_len < sizeof(golden_trace_buffer) / sizeof(golden_trace_buffer[0])) {
+        snprintf(golden_trace_buffer[golden_trace_buffer_len++], sizeof(golden_trace_buffer[0]), "%s", line);
+    }
+}
+
+static void golden_trace_flush_buffer(void)
+{
+    for (size_t i = 0; i < golden_trace_buffer_len; i++) {
+        fputs(golden_trace_buffer[i], golden_trace_file);
+    }
+    golden_trace_buffer_len = 0;
+}
+
+internal void GB_golden_trace_mode3_anchor(GB_gameboy_t *gb)
+{
+    if (!GB_golden_trace_enabled()) return;
+    if (gb->current_line == 0) {
+        if (golden_trace_seen_ly0) golden_trace_frame++;
+        golden_trace_seen_ly0 = true;
+    }
+    else if (golden_trace_target_line) {
+        golden_trace_complete = true;
+        fflush(golden_trace_file);
+        return;
+    }
+
+    golden_trace_line_start_raw = golden_trace_raw_tick - gb->cycles_for_line;
+    golden_trace_mode3_anchor_raw[gb->current_line] = golden_trace_raw_tick + 4;
+    if (golden_trace_schema == 2 && !golden_trace_public && !golden_trace_target_line &&
+        golden_trace_has_env_target &&
+        golden_trace_frame == golden_trace_target_frame &&
+        gb->current_line == golden_trace_target_ly) {
+        golden_trace_target_line = true;
+        golden_trace_v2_state_dumped = false;
+        golden_trace_buffer_len = 0;
+        if (!golden_trace_v2_dump_after_first_write) {
+            golden_trace_v2_state_dumped = true;
+            golden_trace_v23_dump_state(gb);
+        }
+    }
+    if (!golden_trace_target_line) golden_trace_buffer_len = 0;
+}
+
+static bool golden_trace_public_in_window(void)
+{
+    return golden_trace_public && golden_trace_frame >= golden_trace_target_frame && golden_trace_frame <= golden_trace_target_frame + 1;
+}
+
+static uint8_t golden_trace_stat_sources(GB_gameboy_t *gb)
+{
+    uint8_t sources = 0;
+    uint8_t mode = gb->mode_for_interrupt;
+    if (mode == 0 && (gb->io_registers[GB_IO_STAT] & 0x08)) sources |= 0x08;
+    if (mode == 1 && (gb->io_registers[GB_IO_STAT] & 0x10)) sources |= 0x10;
+    if (mode == 2 && (gb->io_registers[GB_IO_STAT] & 0x20)) sources |= 0x20;
+    if ((gb->io_registers[GB_IO_STAT] & 0x40) && gb->lyc_interrupt_line) sources |= 0x40;
+    return sources;
+}
+
+static void golden_trace_v23_public_common(GB_gameboy_t *gb, const char *event, bool irq_edge, uint64_t raw_tick, uint64_t line_tick)
+{
+    uint64_t frame = golden_trace_frame;
+    if (gb->current_line == 0 &&
+        (strcmp(event, "mode2_irq_prepare") == 0 ||
+         strcmp(event, "mode2_enter") == 0 ||
+         strcmp(event, "lcd_on_line0_oam_prelude") == 0)) {
+        frame++;
+    }
+    fprintf(golden_trace_file,
+            "2\tppu_public\t%llu\t%llu\t%u\t%llu\t%.1f\t%s\t%u\t%02X\t%02X\t%02X\t%02X\t%02X\t%.1f\t%u\t%u\t%u\t%u\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n",
+            (unsigned long long)frame,
+            (unsigned long long)raw_tick,
+            gb->current_line,
+            (unsigned long long)line_tick,
+            golden_trace_dot(line_tick),
+            event,
+            gb->mode_for_interrupt & 3,
+            gb->io_registers[GB_IO_STAT],
+            golden_trace_stat_sources(gb),
+            gb->io_registers[GB_IO_IF],
+            gb->interrupt_enable,
+            gb->io_registers[GB_IO_LYC],
+            golden_trace_dot(line_tick),
+            (gb->io_registers[GB_IO_LCDC] & GB_LCDC_ENABLE) ? 1 : 0,
+            irq_edge ? 1 : 0,
+            (unsigned)gb->model,
+            gb->cgb_double_speed ? 1 : 0);
+}
+
+static uint64_t golden_trace_public_tick_for_event(const char *event, uint64_t fallback)
+{
+    if (strcmp(event, "mode2_irq_prepare") == 0) return 2;
+    if (strcmp(event, "mode2_enter") == 0) return 8;
+    if (strcmp(event, "lcd_on_line0_oam_prelude") == 0) return 8;
+    if (strcmp(event, "mode3_enter") == 0 || strcmp(event, "mode3_enter_line0") == 0) return 176;
+    if (strcmp(event, "mode0_enter") == 0) return 520;
+    if (strcmp(event, "frame_vblank") == 0 || strcmp(event, "vblank_irq_edge") == 0) return 6;
+    return fallback;
+}
+
+static uint8_t golden_trace_public_mode_for_event(GB_gameboy_t *gb, const char *event)
+{
+    if (strcmp(event, "mode2_irq_prepare") == 0) return 0;
+    if (strcmp(event, "mode2_enter") == 0 || strcmp(event, "lcd_on_line0_oam_prelude") == 0) return 2;
+    if (strcmp(event, "mode3_enter") == 0 || strcmp(event, "mode3_enter_line0") == 0) return 3;
+    if (strcmp(event, "mode0_enter") == 0 || strcmp(event, "lcd_off") == 0) return 0;
+    if (strcmp(event, "frame_vblank") == 0 || strcmp(event, "vblank_irq_edge") == 0) return 1;
+    return gb->mode_for_interrupt & 3;
+}
