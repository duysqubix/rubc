+            gb->io_registers[GB_IO_LCDC],
+            gb->io_registers[GB_IO_WX],
+            gb->io_registers[GB_IO_WY],
+            (unsigned long long)golden_trace_raw_tick);
+    golden_trace_raw_tick = saved_raw;
+    golden_trace_line_start_raw = saved_line_start;
+    golden_trace_public_initial_dumped = true;
+}
+
+internal void GB_golden_trace_ppu_public(GB_gameboy_t *gb, const char *event, bool irq_edge)
+{
+    if (!GB_golden_trace_enabled() || golden_trace_schema != 2 || !golden_trace_public) return;
+    if (!golden_trace_lcdon_events &&
+        (strcmp(event, "lcd_off") == 0 || strcmp(event, "lcd_on_line0_oam_prelude") == 0)) return;
+    if (!golden_trace_public_in_window()) return;
+    uint64_t fallback_line_start = golden_trace_raw_tick - gb->cycles_for_line;
+    uint64_t fallback_line_tick = golden_trace_raw_tick - fallback_line_start;
+    if (strcmp(event, "mode2_irq_prepare") == 0 || !golden_trace_public_line_start_raw) {
+        golden_trace_public_line_start_raw = golden_trace_raw_tick - golden_trace_public_tick_for_event(event, fallback_line_tick);
+    }
+    uint64_t line_tick = golden_trace_public_tick_for_event(event, fallback_line_tick);
+    uint64_t raw_tick = golden_trace_public_line_start_raw + line_tick;
+    uint8_t saved_mode = gb->mode_for_interrupt;
+    gb->mode_for_interrupt = golden_trace_public_mode_for_event(gb, event);
+    if (strcmp(event, "stat_sample") == 0 || strcmp(event, "stat_irq_edge") == 0) {
+        raw_tick = golden_trace_raw_tick;
+        line_tick = fallback_line_tick;
+        golden_trace_public_line_start_raw = fallback_line_start;
+    }
+    golden_trace_line_start_raw = golden_trace_public_line_start_raw;
+    golden_trace_public_initial_state(gb);
+    golden_trace_v23_public_common(gb, event, irq_edge, raw_tick, line_tick);
+    gb->mode_for_interrupt = saved_mode;
+}
+
+internal void GB_golden_trace_stat_sample(GB_gameboy_t *gb, bool irq_edge)
+{
+    if (!GB_golden_trace_enabled() || golden_trace_schema != 2 || !golden_trace_public || !golden_trace_public_in_window()) return;
+    uint64_t line_start = golden_trace_raw_tick - gb->cycles_for_line;
+    uint64_t line_tick = golden_trace_raw_tick - line_start;
+    golden_trace_line_start_raw = line_start;
+    golden_trace_public_initial_state(gb);
+    golden_trace_v23_public_common(gb, "stat_sample", irq_edge, golden_trace_raw_tick, line_tick);
+    if (irq_edge) golden_trace_v23_public_common(gb, "stat_irq_edge", true, golden_trace_raw_tick, line_tick);
+}
+
+static double golden_trace_dot(uint64_t ticks)
+{
+    return ticks / 2.0;
+}
+
+static void golden_trace_v23_common(GB_gameboy_t *gb, const char *kind, const char *event)
+{
+    uint64_t line_tick = golden_trace_raw_tick - golden_trace_line_start_raw;
+    fprintf(golden_trace_file, "2\t%s\t%llu\t%llu\t%u\t%llu\t%.1f\t%s\t",
+            kind,
+            (unsigned long long)golden_trace_frame,
+            (unsigned long long)golden_trace_raw_tick,
+            gb->current_line,
+            (unsigned long long)line_tick,
+            golden_trace_dot(line_tick),
+            event ?: "");
+}
+
+static void golden_trace_hex_bytes(const uint8_t *data, size_t len)
+{
+    static const char hex[] = "0123456789ABCDEF";
+    for (size_t i = 0; i < len; i++) {
+        fputc(hex[data[i] >> 4], golden_trace_file);
+        fputc(hex[data[i] & 0xF], golden_trace_file);
+    }
+}
+
+static void golden_trace_v23_state_row(GB_gameboy_t *gb, const char *block, int bank, const uint8_t *data, size_t len)
+{
+    golden_trace_v23_common(gb, "vram_state", "");
+    fprintf(golden_trace_file, "%u\t%02X\t\t%02X\t%02X\t%02X\t%.1f\t%u\t\t%u\t%u\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t%s\t",
+            gb->mode_for_interrupt,
+            gb->io_registers[GB_IO_STAT],
+            gb->io_registers[GB_IO_IF],
+            gb->interrupt_enable,
+            gb->io_registers[GB_IO_LYC],
+            golden_trace_dot(golden_trace_raw_tick - golden_trace_line_start_raw),
+            (gb->io_registers[GB_IO_LCDC] & GB_LCDC_ENABLE) ? 1 : 0,
+            (unsigned)gb->model,
+            gb->cgb_double_speed ? 1 : 0,
+            block);
+    if (bank >= 0) fprintf(golden_trace_file, "%d", bank);
+    fprintf(golden_trace_file, "\t%zu\t", len);
+    golden_trace_hex_bytes(data, len);
+    fputc('\n', golden_trace_file);
+}
+
+static void golden_trace_v23_initial_row(GB_gameboy_t *gb, uint16_t addr, uint8_t value)
+{
+    golden_trace_v23_common(gb, "initial_state", "");
+    fprintf(golden_trace_file, "%u\t%02X\t\t%02X\t%02X\t%02X\t%.1f\t%u\t\t%u\t%u\t\t\t\t%04X\t%02X\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n",
+            gb->mode_for_interrupt,
+            gb->io_registers[GB_IO_STAT],
+            gb->io_registers[GB_IO_IF],
+            gb->interrupt_enable,
+            gb->io_registers[GB_IO_LYC],
+            golden_trace_dot(golden_trace_raw_tick - golden_trace_line_start_raw),
+            (gb->io_registers[GB_IO_LCDC] & GB_LCDC_ENABLE) ? 1 : 0,
+            (unsigned)gb->model,
+            gb->cgb_double_speed ? 1 : 0,
+            addr,
+            value);
+}
+
+static void golden_trace_v23_dump_state(GB_gameboy_t *gb)
+{
+    golden_trace_v23_initial_row(gb, 0xFF40, gb->io_registers[GB_IO_LCDC]);
+    golden_trace_v23_initial_row(gb, 0xFF41, gb->io_registers[GB_IO_STAT]);
+    golden_trace_v23_initial_row(gb, 0xFF42, gb->io_registers[GB_IO_SCY]);
+    golden_trace_v23_initial_row(gb, 0xFF43, gb->io_registers[GB_IO_SCX]);
+    golden_trace_v23_initial_row(gb, 0xFF45, gb->io_registers[GB_IO_LYC]);
+
+    uint8_t regs[5] = {
+        gb->io_registers[GB_IO_LCDC],
+        gb->io_registers[GB_IO_SCX],
+        gb->io_registers[GB_IO_SCY],
+        gb->io_registers[GB_IO_WX],
+        gb->io_registers[GB_IO_WY],
+    };
+    golden_trace_v23_state_row(gb, "registers_lcdc_scx_scy_wx_wy", -1, regs, sizeof(regs));
+    golden_trace_v23_state_row(gb, "oam", -1, gb->oam, 0xA0);
+    golden_trace_v23_state_row(gb, "vram", 0, gb->vram, 0x2000);
+    golden_trace_v23_state_row(gb, "vram", 1, gb->vram + 0x2000, 0x2000);
+}
+
+internal void GB_golden_trace_fetch(GB_gameboy_t *gb, const char *state)
+{
+    if (!GB_golden_trace_enabled()) return;
+    if (golden_trace_schema == 2) return;
+    uint64_t line_tick = golden_trace_raw_tick - golden_trace_line_start_raw;
+    double dot = golden_trace_dot(line_tick);
+    double norm_dot = golden_trace_dot(golden_trace_raw_tick - golden_trace_mode3_anchor_raw[gb->current_line]);
+    char line[256];
+    snprintf(line, sizeof(line),
+             "fetch\t%llu\t%llu\t%u\t%llu\t%.1f\t%s\t%u\t%u\t\t\t\t\t\t\t%02X\t%02X\t%02X\t%u\t\t%.1f\n",
+             (unsigned long long)golden_trace_frame,
+             (unsigned long long)golden_trace_raw_tick,
+             gb->current_line,
+             (unsigned long long)line_tick,
+             dot,
+             state,
+             gb->fetcher_state,
+             gb->lcd_x,
+             gb->io_registers[GB_IO_SCY],
+             gb->io_registers[GB_IO_LCDC],
+             gb->io_registers[GB_IO_WX],
+             gb->position_in_line,
+             norm_dot);
+    golden_trace_emit_or_buffer(gb, line);
+}
+
+internal void GB_golden_trace_fetch_v2(GB_gameboy_t *gb, const char *state, uint16_t addr, uint8_t value)
+{
+    if (!GB_golden_trace_enabled() || golden_trace_schema != 2 || !golden_trace_target_line) return;
+    if (gb->current_line != golden_trace_target_ly) return;
+    uint64_t line_tick = golden_trace_raw_tick - golden_trace_line_start_raw;
+    char line[512];
+    snprintf(line, sizeof(line),
+            "2\tppu_internal\t%llu\t%llu\t%u\t%llu\t%.1f\tfetch\t%u\t%02X\t\t%02X\t%02X\t%02X\t%.1f\t%u\t\t%u\t%u\t%s\t%u\t%u\t%04X\t%02X\t\t\t\t\t%02X\t%02X\t%02X\t%02X\t%02X\t%u\t\t\t\t\t\t\t\n",
+            (unsigned long long)golden_trace_frame,
+            (unsigned long long)golden_trace_raw_tick,
+            gb->current_line,
+            (unsigned long long)line_tick,
+            golden_trace_dot(line_tick),
+            gb->mode_for_interrupt,
+            gb->io_registers[GB_IO_STAT],
+            gb->io_registers[GB_IO_IF],
+            gb->interrupt_enable,
+            gb->io_registers[GB_IO_LYC],
+            golden_trace_dot(golden_trace_raw_tick - golden_trace_line_start_raw),
+            (gb->io_registers[GB_IO_LCDC] & GB_LCDC_ENABLE) ? 1 : 0,
+            (unsigned)gb->model,
+            gb->cgb_double_speed ? 1 : 0,
+            state,
+            gb->fetcher_state,
+            gb->lcd_x,
+            addr,
+            value,
+            gb->io_registers[GB_IO_SCY],
+            gb->io_registers[GB_IO_SCX],
+            gb->io_registers[GB_IO_LCDC],
+            gb->io_registers[GB_IO_WX],
+            gb->io_registers[GB_IO_WY],
+            gb->position_in_line);
+    if (!golden_trace_v2_state_dumped) {
+        if (golden_trace_buffer_len < sizeof(golden_trace_buffer) / sizeof(golden_trace_buffer[0])) {
+            snprintf(golden_trace_buffer[golden_trace_buffer_len++], sizeof(golden_trace_buffer[0]), "%s", line);
+        }
+    }
+    else {
+        fputs(line, golden_trace_file);
+    }
+}
+
+internal void GB_golden_trace_write(GB_gameboy_t *gb, uint16_t addr, uint8_t value, const char *conflict)
+{
+    if (!GB_golden_trace_enabled()) return;
+    if (golden_trace_schema == 2) {
+        if (golden_trace_public) {
+            if (!golden_trace_public_in_window()) return;
+            uint64_t line_start = golden_trace_public_line_start_raw ?: (golden_trace_raw_tick - gb->cycles_for_line);
+            uint64_t line_tick = golden_trace_raw_tick - line_start;
+            double dot = golden_trace_dot(line_tick);
+            golden_trace_v23_common(gb, "cpu", "write");
+            fprintf(golden_trace_file, "%u\t%02X\t\t%02X\t%02X\t%02X\t%.1f\t%u\t\t%u\t%u\t\t\t\t%04X\t%02X\t\t\t\t\t%02X\t%02X\t%02X\t%02X\t%02X\t\t%s\t%llu\t%.1f\t\t\t\t\n",
+                    gb->mode_for_interrupt & 3,
+                    gb->io_registers[GB_IO_STAT],
+                    gb->io_registers[GB_IO_IF],
+                    gb->interrupt_enable,
+                    gb->io_registers[GB_IO_LYC],
+                    dot,
+                    (gb->io_registers[GB_IO_LCDC] & GB_LCDC_ENABLE) ? 1 : 0,
+                    (unsigned)gb->model,
+                    gb->cgb_double_speed ? 1 : 0,
+                    addr,
+                    value,
+                    gb->io_registers[GB_IO_SCY],
+                    gb->io_registers[GB_IO_SCX],
+                    gb->io_registers[GB_IO_LCDC],
+                    gb->io_registers[GB_IO_WX],
+                    gb->io_registers[GB_IO_WY],
+                    conflict,
+                    (unsigned long long)golden_trace_raw_tick,
+                    dot);
+            return;
+        }
+        if (!golden_trace_target_line || gb->current_line != golden_trace_target_ly) return;
+        if (!golden_trace_v2_state_dumped) {
+            golden_trace_v23_dump_state(gb);
+            golden_trace_flush_buffer();
+            golden_trace_v2_state_dumped = true;
+        }
+        uint64_t line_tick = golden_trace_raw_tick - golden_trace_line_start_raw;
+        double dot = golden_trace_dot(line_tick);
+        uint64_t visible_tick = golden_trace_raw_tick;
+        double visible_dot = dot;
+        if ((strcmp(conflict, "READ_NEW") == 0 ||
+             addr == 0xFF40 || addr == 0xFF43 || addr == 0xFF4A || addr == 0xFF4B) &&
+            visible_tick > 0) {
+            visible_tick -= 1;
+            visible_dot = golden_trace_dot(line_tick - 1);
+        }
+        golden_trace_v23_common(gb, "cpu", "write");
+        fprintf(golden_trace_file, "%u\t%02X\t\t%02X\t%02X\t%02X\t%.1f\t%u\t\t%u\t%u\t\t\t\t%04X\t%02X\t\t\t\t\t%02X\t%02X\t%02X\t%02X\t%02X\t\t%s\t%llu\t%.1f\t\t\t\t\n",
+                gb->mode_for_interrupt,
+                gb->io_registers[GB_IO_STAT],
+                gb->io_registers[GB_IO_IF],
+                gb->interrupt_enable,
+                gb->io_registers[GB_IO_LYC],
+                dot,
+                (gb->io_registers[GB_IO_LCDC] & GB_LCDC_ENABLE) ? 1 : 0,
+                (unsigned)gb->model,
+                gb->cgb_double_speed ? 1 : 0,
+                addr,
+                value,
+                gb->io_registers[GB_IO_SCY],
+                gb->io_registers[GB_IO_SCX],
+                gb->io_registers[GB_IO_LCDC],
+                gb->io_registers[GB_IO_WX],
+                gb->io_registers[GB_IO_WY],
+                conflict,
+                (unsigned long long)visible_tick,
+                visible_dot);
+        return;
+    }
+    if (addr == 0xFF42 && value == 0x03 && strcmp(conflict, "READ_NEW") == 0) {
+        golden_trace_target_line = true;
+        golden_trace_target_ly = gb->current_line;
+        golden_trace_flush_buffer();
+    }
+    if (!golden_trace_target_line) return;
+    if (gb->current_line != golden_trace_target_ly) return;
+    uint64_t line_tick = golden_trace_raw_tick - golden_trace_line_start_raw;
+    double dot = golden_trace_dot(line_tick);
+    double norm_dot = golden_trace_dot(golden_trace_raw_tick - golden_trace_mode3_anchor_raw[gb->current_line]);
+    char line[256];
+    snprintf(line, sizeof(line),
+             "write\t%llu\t%llu\t%u\t%llu\t%.1f\t\t\t\t%04X\t%02X\t\t\t\t\t%02X\t%02X\t%02X\t\t%s\t%.1f\n",
+             (unsigned long long)golden_trace_frame,
+             (unsigned long long)golden_trace_raw_tick,
+             gb->current_line,
+             (unsigned long long)line_tick,
+             dot,
+             addr,
+             value,
+             gb->io_registers[GB_IO_SCY],
+             gb->io_registers[GB_IO_LCDC],
+             gb->io_registers[GB_IO_WX],
+             conflict,
+             norm_dot);
+    fputs(line, golden_trace_file);
+}
