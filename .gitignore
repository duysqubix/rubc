# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb


# Added by cargo

/target

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key


# GameBoy emulator reference material (docs + test suites).
# Cloned locally for reference only; .git stripped. NEVER commit to rubc.
/reference/

# Local-only agent / tooling scaffolding (issue tracker, agent configs, skills).
# Kept per-machine; never committed.
/.beads/
/.claude/
/.codex/
/.omo/
/.agents/
graph.svg
# Disassembly dumps produced by `just disasm` / --disassemble.
*.gb.txt
.DS_Store
assets/*.gb
assets/*.gbc

# Battery-backed save files (user save data, not source)
*.sav

# Generated wasm-bindgen output for the rubc-wasm web demo.
rubc-wasm/web/pkg/
