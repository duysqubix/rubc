# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb


# Added by cargo

/target

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key


# GameBoy emulator reference material (docs + test suites) is COMMITTED to the
# repo (rubc-ng's ROM-driven conformance tests need it present in any checkout).
# Keep out only regenerable build cruft + golden traces (reproducible from
# reference/goldens/instrumentation.patch against SameBoy).

# Local-only agent / tooling scaffolding (agent configs, skills).
# Kept per-machine; never committed. (.beads IS tracked; .agents/skills/release/ IS tracked — the release runbook ships with the repo.)
/.claude/
/.codex/
/.omo/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/release/
graph.svg
# Disassembly dumps produced by `just disasm` / --disassemble.
*.gb.txt
.DS_Store
assets/*.gb
assets/*.gbc

# Battery-backed save files (user save data, not source)
*.sav

# Generated wasm-bindgen output for the rubc-wasm web demo.
rubc-wasm/web/pkg/

# Production TLS material (Cloudflare Origin cert + key). NEVER commit these.
deploy/certs/*.pem
deploy/certs/*.key
deploy/certs/*.crt

# Regenerable reference cruft (do NOT commit): assembler intermediates and
# redundant source zips superseded by extracted ROMs.
# (golden traces under reference/goldens/ ARE committed — SameBoy-sourced
# hardware-truth oracles, reproducible from reference/goldens/instrumentation.patch.)
reference/test-suites/mooneye-test-suite/build/**/*.o
reference/test-suites/mooneye-test-suite/build/**/*.sym
reference/test-suites/mooneye-test-suite/build/**/*.map
reference/test-suites/mooneye-test-suite/build/**/*.d
reference/test-suites/mealybug/mealybug-tearoom-tests.zip
reference/docs/pandocs/historical/misc/ATX-GBI.zip
